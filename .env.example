# .env.example — a TEMPLATE listing the settings the app needs.
# Copy it:  cp .env.example .env   then fill in real values in .env.
# .env is git-ignored, so your real values never get uploaded to GitHub.
# NEVER put real secrets in this file.

APP_ENV=dev
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=eastus
