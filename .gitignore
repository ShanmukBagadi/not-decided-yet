# .gitignore — files git should NEVER track or upload.

# Secrets
.env
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/

# Azure / Bicep build output
infra/*.json

# Editors & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Claude Code personal settings (team settings in .claude/settings.json ARE shared)
.claude/settings.local.json
